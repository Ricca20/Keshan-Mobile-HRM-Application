# Copy to .env and fill in. Only variables the app reads are listed here.

# PostgreSQL (Supabase pooler URL works)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Auth.js — generate a secret with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Public URL used in emailed links. Set this in Vercel Production (e.g. https://hr.example.com).
# If unset on Vercel, the deployment's own URL is used; localhost values are ignored there.
APP_URL=""

NEXT_PUBLIC_APP_NAME="PhoneShop HRM"

# Email: either a transactional provider on your own domain (recommended, avoids spam)...
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""          # e.g. hr@yourdomain.com
EMAIL_REPLY_TO=""      # optional
# ...or Gmail with an app password (used when SMTP_HOST is empty)
EMAIL_USER=""
EMAIL_PASS=""

# Shared secret for /api/cron/* (Vercel cron and the GitHub Actions workflow). At least 16 characters.
CRON_SECRET=""
